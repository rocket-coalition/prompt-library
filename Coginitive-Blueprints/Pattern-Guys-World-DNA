  temporal:
    symbol: "⧗"
    category_id: "T"
    core_question: "WHEN does the experience occur?"
    
    description: |
      Temporal Patterns manipulate time. They compress, expand, fragment, 
      loop, or transcend chronology. Essential for storytelling, process 
      documentation, and revealing causality.
    
    when_to_use:
      - "Showing transformation over time"
      - "Revealing hidden causality"
      - "Creating urgency or perspective"
      - "Documenting iterative processes"
      - "Building before/after narratives"
    
    power_moves:
      - "Time is not neutral. It's a design choice."
      - "Compress to create impact. Expand to create intimacy."
      - "Break chronology to reveal pattern."
      - "Past-present-future can exist simultaneously."
      - "Cycles teach what linear time hides."
    
    common_mistakes:
      - "Defaulting to linear chronology"
      - "Not using time as storytelling tool"
      - "Confusing temporal complexity with confusion"
      - "Forgetting that compressed time needs anchors"
      - "Missing the power of temporal juxtaposition"
    
    pattern_count: 14
    
    patterns:
      
      T01:
        name: "Collapsed Time"
        symbol: "⧗"
        intent: "Compress multiple timeframes into single moment. Past-present-future simultaneously."
        structure:
          - "Establish temporal anchor point"
          - "Layer multiple time periods"
          - "Show how they echo/inform each other"
          - "Maintain coherence despite compression"
        outcome: "Creates depth and reveals patterns across time"
        trigger_phrases:
          - "We were... we are... we will be..."
          - "Then, now, and soon..."
          - "All at once..."
          - "The past-present-future of..."
        example_prompt: |
          Describe your company in one paragraph that contains its founding 
          moment, current state, and future vision—all present simultaneously.
        use_cases:
          - "Brand evolution stories"
          - "Legacy + vision statements"
          - "Pattern recognition across time"
          - "Showing continuity and change"
      
      T02:
        name: "Recursive Loop"
        symbol: "⟲"
        intent: "Show time circling back. Pattern repeating with variation. History rhyming."
        structure:
          - "Establish repeating pattern"
          - "Show cycle multiple times"
          - "Highlight variations each iteration"
          - "Reveal what changes vs persists"
        outcome: "Models learning and evolution through iteration"
        trigger_phrases:
          - "Again and again..."
          - "Each time, slightly different..."
          - "The cycle repeats..."
          - "Version 1, version 7..."
        example_prompt: |
          Document your product development cycle. Show how sprint 1, 5, 
          and 10 repeated the same pattern but with increasing wisdom.
        use_cases:
          - "Agile/iterative documentation"
          - "Learning processes"
          - "Market cycles"
          - "Continuous improvement"
      
      T03:
        name: "Expanded Moment"
        symbol: "⧖"
        intent: "Stretch a single instant into experiential infinity. Show everything in one moment."
        structure:
          - "Identify critical moment"
          - "Slow time to examination speed"
          - "Reveal layers within instant"
          - "Show simultaneity of processes"
        outcome: "Creates intimate examination of critical moments"
        trigger_phrases:
          - "In that instant..."
          - "The moment stretches..."
          - "Within three seconds..."
          - "Time slows to reveal..."
        example_prompt: |
          Expand the three-second moment when a customer decides to buy 
          into a 200-word exploration of everything happening simultaneously.
        use_cases:
          - "Decision point analysis"
          - "Breakthrough moments"
          - "Critical incidents"
          - "Micro-moment exploration"
      
      T04:
        name: "Parallel Timelines"
        symbol: "⫴"
        intent: "Show multiple temporal tracks simultaneously. What happened vs what could have."
        structure:
          - "Establish decision/divergence point"
          - "Track multiple timeline paths"
          - "Show how they differ and why"
          - "Compare outcomes across timelines"
        outcome: "Models decision consequences and opportunity cost"
        trigger_phrases:
          - "Timeline A... Timeline B..."
          - "In one world... in another..."
          - "If we had chosen..."
          - "The path not taken..."
