pattern_categories:
  
  # --------------------------------------------------------------------------
  # CATEGORY 1: EMBODIMENT PATTERNS
  # --------------------------------------------------------------------------
  
  embodiment:
    symbol: "◉"
    category_id: "E"
    core_question: "WHO experiences the information?"
    
    description: |
      Embodiment Patterns shift consciousness perspective. They change who 
      is experiencing, thinking, or perceiving. The foundation of all 
      storytelling, documentation, and communication.
    
    when_to_use:
      - "Creating immersive documentation"
      - "Building empathy for stakeholders"
      - "Writing from character perspective"
      - "Shifting reader consciousness"
      - "Teaching through experience rather than instruction"
    
    power_moves:
      - "Stop describing. Start inhabiting."
      - "Remove narrative distance completely."
      - "Put reader inside the consciousness."
      - "Multiple perspectives reveal multiple truths."
      - "Non-human embodiment reveals invisible insights."
    
    common_mistakes:
      - "Staying in third-person observer mode"
      - "Telling instead of experiencing"
      - "Switching perspectives without clear transitions"
      - "Forgetting embodiment constraints (what can this entity actually know?)"
      - "Using embodiment for gimmick instead of insight"
    
    pattern_count: 14
    
    patterns:
      
