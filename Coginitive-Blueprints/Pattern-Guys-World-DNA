          - "Customer transformation narratives"
          - "Reflective case studies"
          - "Vision casting"
      
      E07:
        name: "Shadow Perspective"
        symbol: "◑"
        intent: "Inhabit the inverse, opposite, hidden side. Voice the unspoken."
        structure:
