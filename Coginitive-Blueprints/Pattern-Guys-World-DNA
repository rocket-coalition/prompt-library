# ============================================================================
# THE SEVEN LAWS: Foundational Principles
# ============================================================================

seven_laws:
  
  law_1:
    name: "The Law of Recognition"
    statement: "Patterns exist whether you see them or not. Your job is recognition, not invention."
    application: "Stop trying to be original. Start recognizing what already works."
    muscle_memory: "Before building anything, ask: What pattern am I actually using?"
    
  law_2:
    name: "The Law of Seven"
    statement: "The human mind holds seven things. Work with the architecture, not against it."
    application: "Chunk everything into groups of seven. Categories, steps, examples, all sevens."
    muscle_memory: "When overwhelmed, find the seven core elements. Ignore the rest."
    
  law_3:
    name: "The Law of Exchange"
    statement: "Everything is trading something for something else. Map the exchange, understand the system."
    application: "Never describe a thing. Describe what it exchanges with what."
    muscle_memory: "Ask constantly: What's being exchanged here?"
    
  law_4:
    name: "The Law of Iteration"
    statement: "First draft shows what you think. Seventh iteration shows what's real."
    application: "Never ship version one. The truth emerges through refinement."
    muscle_memory: "Build fast. Iterate seven times. Ship the seventh."
    
  law_5:
    name: "The Law of Constraint"
    statement: "Infinite possibility paralyzes. Constraint creates direction."
    application: "Start every project by defining what you WON'T do."
    muscle_memory: "Before adding, subtract. Before expanding, constrain."
    
  law_6:
    name: "The Law of Emergence"
    statement: "Patterns combine to create patterns you never designed."
    application: "Build simple patterns. Let complexity emerge from combination."
    muscle_memory: "When stuck, combine two existing patterns. See what emerges."
    
  law_7:
    name: "The Law of Articulation"
    statement: "You can only build what you can describe structurally."
    application: "If you can't name the pattern, you can't use it consistently."
    muscle_memory: "Fuzzy thinking = fuzzy building. Structural clarity = clean execution."

