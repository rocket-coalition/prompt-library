        use_cases:
          - "System architecture documentation"
          - "Technical explanation through metaphor"
          - "Object-oriented thinking"
          - "Creative problem-solving"
      
      E05:
        name: "Collective Voice"
        symbol: "◉∞"
        intent: "Speak as group consciousness. The 'we' that thinks as one while containing multitudes."
        structure:
          - "Establish collective identity"
          - "Use first-person plural"
          - "Show shared values/beliefs"
          - "Include diversity within unity"
        outcome: "Creates belonging and shared purpose"
        trigger_phrases:
          - "We are the ones who..."
          - "We believe..."
          - "Together we..."
          - "Our generation..."
